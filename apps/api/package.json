{
  "name": "@ft360/api",
  "version": "0.1.0",
  "private": true,
  "description": "Authoritative NestJS Modular Monolith Backend (Native pg + PostgreSQL 18 RLS + Redis/BullMQ)",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node scripts/dev-watch.mjs",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "db:migrate": "tsc -p tsconfig.build.json && node dist/database/migrations/cli.js up",
    "db:migrate:status": "tsc -p tsconfig.build.json && node dist/database/migrations/cli.js status",
    "db:migrate:rollback": "tsc -p tsconfig.build.json && node dist/database/migrations/cli.js down",
    "test:unit": "jest --config ./test/jest-unit.json",
    "test:integration": "jest --config ./test/jest-integration.json --runInBand",
    "test": "npm run test:unit && npm run test:integration"
  },
  "dependencies": {
    "@ft360/shared-types": "*",
    "@nestjs/bullmq": "^11.0.1",
    "@nestjs/common": "^11.0.11",
    "@nestjs/config": "^4.0.1",
    "@nestjs/core": "^11.0.11",
    "@nestjs/platform-express": "^11.0.11",
    "@nestjs/swagger": "^11.0.6",
    "bullmq": "^5.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "ioredis": "^5.6.0",
    "pg": "^8.13.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.11",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.6"
  }
}
