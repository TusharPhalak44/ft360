# =============================================================================
# Backend Service (@ft360/api) – Environment Template
# Values automatically inherit from root `.env` during workspace dev, or can be
# supplied directly to the API service container. NEVER commit real credentials.
# =============================================================================

NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
CORS_ALLOWED_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true

# Database Roles (Migrator owns schema; App runs runtime queries with NOBYPASSRLS)
DATABASE_MIGRATOR_URL=postgresql://ft360_migrator:change_me_local_migrator_pw@localhost:5433/ft360_dev
DATABASE_APP_URL=postgresql://ft360_app:change_me_local_app_pw@localhost:5433/ft360_dev

DB_POOL_MIN=2
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000

# Redis (Cache + BullMQ Queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_local_redis_pw
REDIS_DB_CACHE=0
REDIS_DB_QUEUE=1

# Configurable Bootstrap Branding Defaults
DEFAULT_PRODUCT_NAME=FunnelTrack360
DEFAULT_PRODUCT_TAGLINE=Enterprise Multi-Tenant CRM & Operations Suite
DEFAULT_SUPPORT_EMAIL=support@example.local
DEFAULT_WEBSITE_URL=http://localhost:3000
DEFAULT_PRIMARY_COLOR_HEX=#2563EB
DEFAULT_ACCENT_COLOR_HEX=#0F172A

