# =============================================================================
# Platform Foundation – Root & Infrastructure Environment Template
# Copy this file to `.env` for local development. NEVER commit real secrets.
# =============================================================================

NODE_ENV=development

# --- Configurable Product Identity (Bootstrap Fallback Only) ---
DEFAULT_PRODUCT_NAME=FunnelTrack360
DEFAULT_PRODUCT_TAGLINE=Enterprise Multi-Tenant CRM & Operations Suite
DEFAULT_SUPPORT_EMAIL=support@example.local
DEFAULT_WEBSITE_URL=http://localhost:3000
DEFAULT_PRIMARY_COLOR_HEX=#2563EB
DEFAULT_ACCENT_COLOR_HEX=#0F172A

# --- PostgreSQL 18 Container Configuration ---
# Spec default maps host port 5433 -> container 5432.
# Note: If a local Windows PostgreSQL service occupies 5433, set POSTGRES_HOST_PORT=5434 in `.env`.
POSTGRES_HOST_PORT=5433
POSTGRES_DB=ft360_dev
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change_me_local_superuser_pw

# Dedicated DDL Migration Role (owns tables; used ONLY by migration CLI)
DB_MIGRATOR_USER=ft360_migrator
DB_MIGRATOR_PASSWORD=change_me_local_migrator_pw

# Restricted Application Runtime Role (NOSUPERUSER, NOBYPASSRLS, NEVER owns protected tables)
DB_APP_USER=ft360_app
DB_APP_PASSWORD=change_me_local_app_pw

# Connection URLs consumed by Backend & Migration CLI
DATABASE_MIGRATOR_URL=postgresql://ft360_migrator:change_me_local_migrator_pw@localhost:5433/ft360_dev
DATABASE_APP_URL=postgresql://ft360_app:change_me_local_app_pw@localhost:5433/ft360_dev

# Connection Pool Tuning
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000

# --- Redis Container Configuration ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_local_redis_pw
REDIS_DB_CACHE=0
REDIS_DB_QUEUE=1

# --- NestJS Backend Service ---
API_HOST=0.0.0.0
API_PORT=4000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SWAGGER_ENABLED=true

# --- Next.js Frontend Service ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
WEB_PORT=3000

# --- Phase 3 Authentication, Session, Cookie & Rate-Limit Settings ---
# Required in production (minimum 32 characters). Never commit production secrets.
AUTH_JWT_SECRET=change_me_local_auth_jwt_signing_secret_minimum_32_chars
AUTH_JWT_ISSUER=ft360-auth
AUTH_JWT_AUDIENCE=ft360-web-api
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_IDLE_TTL_SECONDS=604800
AUTH_SESSION_ABSOLUTE_TTL_SECONDS=2592000
AUTH_EMAIL_VERIFY_TTL_SECONDS=86400
AUTH_PASSWORD_RESET_TTL_SECONDS=1800
# Cookie Security: COOKIE_SECURE defaults to true in production and CANNOT be false in production.
# Omit COOKIE_DOMAIN for host-only cookies (recommended); if set, use a valid multi-label domain (e.g. app.example.com).
COOKIE_SECURE=false
COOKIE_DOMAIN=
AUTH_ARGON2_MEMORY_COST_KIB=65536
AUTH_ARGON2_TIME_COST=3
AUTH_ARGON2_PARALLELISM=4
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_MAX_FAILURES=5
AUTH_RATE_LIMIT_LOCKOUT_SECONDS=900
AUTH_RATE_LIMIT_IP_BURST_MAX=30

# Development Outbox Preview: defaults to false. Permitted ONLY in NODE_ENV=development or NODE_ENV=test.
# Startup fails closed if enabled in staging, preview, or production.
AUTH_DEV_OUTBOX_ENABLED=false

# --- Transactional Authentication Email Provider & Durable Outbox ---
# Supported providers: disabled (default, never claims delivery) | smtp | webhook | sandbox (dev/test only)
AUTH_MAIL_PROVIDER=disabled
AUTH_MAIL_FROM_EMAIL=no-reply@example.local
AUTH_MAIL_FROM_NAME=FunnelTrack360
# Optional dedicated >=32-char secret for AES-256-GCM outbox sealing (falls back to HKDF over AUTH_JWT_SECRET)
AUTH_OUTBOX_ENCRYPTION_SECRET=
AUTH_MAIL_MAX_ATTEMPTS=5
AUTH_MAIL_BASE_BACKOFF_SECONDS=5
AUTH_MAIL_MAX_BACKOFF_SECONDS=300
AUTH_MAIL_OUTBOX_POLL_MS=15000

# SMTP Adapter Settings (required when AUTH_MAIL_PROVIDER=smtp)
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_SECURE=false
AUTH_SMTP_REQUIRE_TLS=false
AUTH_SMTP_USER=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_TIMEOUT_MS=10000

# HTTPS Webhook Adapter Settings (required when AUTH_MAIL_PROVIDER=webhook; HTTPS mandatory in production)
AUTH_MAIL_WEBHOOK_URL=
AUTH_MAIL_WEBHOOK_BEARER_TOKEN=
AUTH_MAIL_WEBHOOK_TIMEOUT_MS=10000

# --- Controlled One-Time Initial Super Admin Provisioning (CLI Only) ---
# Normal application startup NEVER promotes accounts or overwrites passwords.
# Populate temporarily ONLY when running `npm run auth:bootstrap-super-admin --workspace=@ft360/api`,
# then immediately remove these secrets from the environment.
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
BOOTSTRAP_SUPER_ADMIN_FULL_NAME=


