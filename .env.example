# =============================================================================
# Platform Foundation – Root & Infrastructure Environment Template
# Copy this file to `.env` for local development. NEVER commit real secrets.
# =============================================================================

NODE_ENV=development

# --- Configurable Product Identity (Bootstrap Fallback Only) ---
DEFAULT_PRODUCT_NAME=FunnelTrack360
DEFAULT_PRODUCT_TAGLINE=Enterprise Multi-Tenant CRM & Operations Suite
DEFAULT_SUPPORT_EMAIL=support@example.local
DEFAULT_WEBSITE_URL=http://localhost:3000
DEFAULT_PRIMARY_COLOR_HEX=#2563EB
DEFAULT_ACCENT_COLOR_HEX=#0F172A

# --- PostgreSQL 18 Container Configuration ---
# Spec default maps host port 5433 -> container 5432.
# Note: If a local Windows PostgreSQL service occupies 5433, set POSTGRES_HOST_PORT=5434 in `.env`.
POSTGRES_HOST_PORT=5433
POSTGRES_DB=ft360_dev
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change_me_local_superuser_pw

# Dedicated DDL Migration Role (owns tables; used ONLY by migration CLI)
DB_MIGRATOR_USER=ft360_migrator
DB_MIGRATOR_PASSWORD=change_me_local_migrator_pw

# Restricted Application Runtime Role (NOSUPERUSER, NOBYPASSRLS, NEVER owns protected tables)
DB_APP_USER=ft360_app
DB_APP_PASSWORD=change_me_local_app_pw

# Connection URLs consumed by Backend & Migration CLI
DATABASE_MIGRATOR_URL=postgresql://ft360_migrator:change_me_local_migrator_pw@localhost:5433/ft360_dev
DATABASE_APP_URL=postgresql://ft360_app:change_me_local_app_pw@localhost:5433/ft360_dev

# Connection Pool Tuning
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000

# --- Redis Container Configuration ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_local_redis_pw
REDIS_DB_CACHE=0
REDIS_DB_QUEUE=1

# --- NestJS Backend Service ---
API_HOST=0.0.0.0
API_PORT=4000
CORS_ALLOWED_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true

# --- Next.js Frontend Service ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
WEB_PORT=3000

